{
  "name": "@testforge/sample-app",
  "version": "0.1.0",
  "description": "Demo Express API for TestForge — intentionally under-tested",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --coverage",
    "test:coverage": "nyc jest"
  },
  "dependencies": {
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "nyc": "^15.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.js"],
    "collectCoverage": true,
    "coverageReporters": ["text", "json"],
    "coverageDirectory": "coverage"
  }
}
