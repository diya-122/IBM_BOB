{
  "name": "@testforge/engine",
  "version": "0.1.0",
  "description": "TestForge CLI engine — intelligent test generation",
  "main": "dist/index.js",
  "bin": { "testforge": "dist/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "istanbul-lib-coverage": "^3.2.2",
    "nyc": "^15.1.0",
    "ora": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
