# Dashboard environment variables
# Copy this file to .env — the defaults work out of the box on any machine.

# URL of the running TestForge engine API server
VITE_API_URL=http://localhost:4001

# Path to the project the engine will analyze.
#
# The DEFAULT value ./sample-app is a relative path that the engine resolves
# against the repo root, so it works on every machine without change.
#
# You only need to edit this if you want to point TestForge at a DIFFERENT
# project.  In that case use either:
#   • a relative path from the repo root:   ../my-other-app
#   • a Linux/WSL absolute path:            /home/you/my-other-app
#
# ⚠  Do NOT use Windows paths (C:\...) — the engine runs on Linux/WSL.
VITE_PROJECT_PATH=./sample-app
